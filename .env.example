# Copy to .env and edit. .env is gitignored and agents are denied read/write on it.

# ---- Mode --------------------------------------------------------------
# paper (default) or live. Live additionally requires LIVE_TRADING_ACK below
# AND --confirm-live on each order command.
TRADING_MODE=paper

# ---- Connection --------------------------------------------------------
IBKR_HOST=127.0.0.1
# TWS paper 7497 | TWS live 7496 | Gateway paper 4002 | Gateway live 4001
IBKR_PORT=7497
IBKR_CLIENT_ID=17
# Blank = use the first managed account returned by TWS
IBKR_ACCOUNT=
# 1=live data (needs subscription), 3=delayed (default, free)
IBKR_MKT_DATA_TYPE=3

# ---- Risk limits (enforced in trading/risk.py) -------------------------
MAX_ORDER_NOTIONAL=5000
# Per SYMBOL.
MAX_POSITION_NOTIONAL=10000
# Ceiling on the WHOLE book. Without it, N symbols can each sit at the
# per-symbol cap and no check objects. Only read once the gross-exposure check
# is applied to trading/risk.py; ignored before that.
MAX_GROSS_NOTIONAL=70000
MAX_OPEN_ORDERS=10
MAX_DAILY_LOSS=500
# Comma-separated symbols agents may never trade
RESTRICTED_SYMBOLS=

# ---- Live trading acknowledgement --------------------------------------
# Uncomment ONLY if you intend to trade real money. Set by a human, never by an
# agent. Without this exact value, live orders are refused in code.
# LIVE_TRADING_ACK=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
